{
  "name": "android-time-machine",
  "private": true,
  "description": "Eight Android releases in the browser, each rebuilt from its own factory image.",
  "scripts": {
    "test": "node --test tests/*.cjs",
    "test:browser": "node tests/browser/flows.mjs && node tests/browser/ng-release.mjs",
    "check:texts": "node docs/tools/text-check.mjs",
    "check:assets": "node docs/tools/asset-check.mjs",
    "check:fonts": "node docs/tools/font-check.mjs",
    "regenerate:texts": "node docs/tools/texts.mjs --check",
    "regenerate:assets": "python docs/tools/asset-inventory.py --check",
    "check:unused-assets": "node docs/tools/asset-unused.mjs",
    "check:unused-css": "node docs/tools/css-unused.mjs",
    "check:unreachable": "node docs/tools/action-unused.mjs"
  }
}
